+    suspend fun scanCheckpoints(): List<String>? {
+        val urls = listOf(settings.url.first(), settings.tunnel.first()).filter { it.isNotBlank() }.distinct()
+        return withContext(Dispatchers.IO) {
+            for (u in urls) {
